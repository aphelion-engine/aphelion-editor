{
  "format": "aphelion-graph",
  "version": 1,
  "name": "Enterprise Multi-Tracker Scene",
  "nodes": [
    {"id": "video", "type": "Video Input", "position": [60, 420], "properties": {"file_path": "$USER_VIDEO"}},
    {"id": "floor", "type": "Floor Tracker", "position": [380, 40], "properties": {"region_size": 22.0, "search_radius": 24.0}},
    {"id": "wall", "type": "Wall Tracker", "position": [380, 300], "properties": {"region_size": 18.0, "search_radius": 20.0}},
    {"id": "object", "type": "Object Tracker", "position": [380, 620], "properties": {"mode": {"__enum__": "TrackingMode", "name": "ACCURATE"}, "deep_recovery": true, "reidentification": true}},
    {"id": "camera", "type": "Camera Tracker", "position": [380, 900], "properties": {"mode": {"__enum__": "TrackingMode", "name": "BALANCED"}}},
    {"id": "floor_graphic", "type": "Image Input", "position": [720, 40], "properties": {"file_path": "$FLOOR_GRAPHIC"}},
    {"id": "wall_graphic", "type": "Image Input", "position": [720, 300], "properties": {"file_path": "$WALL_ARTWORK"}},
    {"id": "floor_pin", "type": "Corner Pin", "position": [1030, 40], "properties": {}},
    {"id": "wall_pin", "type": "Corner Pin", "position": [1030, 300], "properties": {}},
    {"id": "tracked_image", "type": "Image Input", "position": [720, 620], "properties": {"file_path": "$OBJECT_GRAPHIC"}},
    {"id": "motion_match", "type": "Transform 2D", "position": [1030, 620], "properties": {}},
    {"id": "distance", "type": "Track Distance", "position": [720, 900], "properties": {}},
    {"id": "floor_comp", "type": "Merge", "position": [1370, 120], "properties": {}},
    {"id": "wall_comp", "type": "Merge", "position": [1660, 120], "properties": {}},
    {"id": "final_comp", "type": "Merge", "position": [1950, 260], "properties": {}},
    {"id": "viewer", "type": "Viewer", "position": [2240, 260], "properties": {}}
  ],
  "connections": [
    {"from": ["video", "frame"], "to": ["floor", "frame"]},
    {"from": ["video", "frame"], "to": ["wall", "frame"]},
    {"from": ["video", "frame"], "to": ["object", "frame"]},
    {"from": ["video", "frame"], "to": ["camera", "frame"]},
    {"from": ["floor_graphic", "frame"], "to": ["floor_pin", "frame"]},
    {"from": ["wall_graphic", "frame"], "to": ["wall_pin", "frame"]},
    {"from": ["floor", "top_left_x"], "to": ["floor_pin", "in_top_left_x"]},
    {"from": ["floor", "top_left_y"], "to": ["floor_pin", "in_top_left_y"]},
    {"from": ["floor", "top_right_x"], "to": ["floor_pin", "in_top_right_x"]},
    {"from": ["floor", "top_right_y"], "to": ["floor_pin", "in_top_right_y"]},
    {"from": ["floor", "bottom_right_x"], "to": ["floor_pin", "in_bottom_right_x"]},
    {"from": ["floor", "bottom_right_y"], "to": ["floor_pin", "in_bottom_right_y"]},
    {"from": ["floor", "bottom_left_x"], "to": ["floor_pin", "in_bottom_left_x"]},
    {"from": ["floor", "bottom_left_y"], "to": ["floor_pin", "in_bottom_left_y"]},
    {"from": ["wall", "top_left_x"], "to": ["wall_pin", "in_top_left_x"]},
    {"from": ["wall", "top_left_y"], "to": ["wall_pin", "in_top_left_y"]},
    {"from": ["wall", "top_right_x"], "to": ["wall_pin", "in_top_right_x"]},
    {"from": ["wall", "top_right_y"], "to": ["wall_pin", "in_top_right_y"]},
    {"from": ["wall", "bottom_right_x"], "to": ["wall_pin", "in_bottom_right_x"]},
    {"from": ["wall", "bottom_right_y"], "to": ["wall_pin", "in_bottom_right_y"]},
    {"from": ["wall", "bottom_left_x"], "to": ["wall_pin", "in_bottom_left_x"]},
    {"from": ["wall", "bottom_left_y"], "to": ["wall_pin", "in_bottom_left_y"]},
    {"from": ["video", "frame"], "to": ["floor_comp", "background"]},
    {"from": ["floor_pin", "frame"], "to": ["floor_comp", "foreground"]},
    {"from": ["floor_comp", "frame"], "to": ["wall_comp", "background"]},
    {"from": ["wall_pin", "frame"], "to": ["wall_comp", "foreground"]},
    {"from": ["tracked_image", "frame"], "to": ["motion_match", "frame"]},
    {"from": ["camera", "translation_x"], "to": ["motion_match", "in_translate_x"]},
    {"from": ["camera", "translation_y"], "to": ["motion_match", "in_translate_y"]},
    {"from": ["object", "x"], "to": ["distance", "x1"]},
    {"from": ["object", "y"], "to": ["distance", "y1"]},
    {"from": ["floor", "top_left_x"], "to": ["distance", "x2"]},
    {"from": ["floor", "top_left_y"], "to": ["distance", "y2"]},
    {"from": ["wall_comp", "frame"], "to": ["final_comp", "background"]},
    {"from": ["motion_match", "frame"], "to": ["final_comp", "foreground"]},
    {"from": ["final_comp", "frame"], "to": ["viewer", "frame"]}
  ],
  "groups": [
    {"label": "INPUT", "rect": [20, 350, 300, 220]},
    {"label": "TRACKING", "rect": [340, 0, 500, 1150]},
    {"label": "GEOMETRY + MOTION", "rect": [680, 0, 760, 1050]},
    {"label": "COMPOSITING", "rect": [1330, 80, 1000, 430]}
  ],
  "annotations": [
    {"type": "callout", "text": "The source branch is shared; each tracker observes the same footage but produces a different reusable data stream.", "position": [380, -30]},
    {"type": "callout", "text": "Track Distance demonstrates that tracker values are ordinary graph data, not UI-only overlays.", "position": [720, 870]}
  ]
}

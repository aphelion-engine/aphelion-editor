{
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.languageServer": "pylance",
    "cursorpyright.analysis.autoImportCompletions": true,
    "cursorpyright.analysis.typeCheckingMode": "off",
    "cursorpyright.analysis.useLibraryCodeForTypes": true,
    "cursorpyright.analysis.diagnosticMode": "openFilesOnly",
    "cursorpyright.analysis.disableWorkspaceSymbol": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/src"
    ],
    "cursorpyright.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/src"
    ],
    "cursorpyright.analysis.exclude": [
        "**/.venv",
        "**/__pycache__",
        "**/node_modules",
        "**/build",
        "**/dist",
        "**/.mypy_cache",
        "**/.pytest_cache"
    ],
    "CodeGPT.apiKey": "CodeGPT Plus Beta"
}

{
  "version": 1,
  "editor": {
    "editor_font_family": "JetBrains Mono",
    "editor_font_size": 16,
    "show_graph_grid": true,
    "autosave_enabled": true,
    "autosave_interval_ms": 30000,
    "show_status_key_hints": true,
    "show_pin_bar": false
  },
  "theme": {
    "active_theme_id": "aphelion_dark"
  },
  "performance": {
    "frame_cache_mb": 4096,
    "decode_cache_frames": 32,
    "max_prefetch_frames": 4,
    "hardware_decode_enabled": true,
    "playback_proxy_override_enabled": true,
    "playback_proxy_width": 640,
    "drop_frames_during_playback": true,
    "show_performance_overlay": false
  },
  "audio": {
    "audio_enabled": true,
    "master_volume": 1.0,
    "default_device_index": -1,
    "buffer_size": 10
  },
  "plugins": {
    "load_bundled": true,
    "load_user": true,
    "load_entry_points": true,
    "disabled_plugin_keys": []
  },
  "node_colors": {},
  "keybinds": {
    "new_project": "Ctrl+N",
    "open_project": "Ctrl+O",
    "save_project": "Ctrl+S",
    "save_project_as": "Ctrl+Shift+S",
    "project_settings": "Ctrl+Shift+,",
    "export_sequence": "Ctrl+E",
    "clear_cache": "Ctrl+Shift+K",
    "toggle_logs": "Ctrl+Shift+L",
    "exit": "Ctrl+Q",
    "undo": "Ctrl+Z",
    "redo": "Ctrl+Shift+Z",
    "copy": "Ctrl+C",
    "paste": "Ctrl+V",
    "select_all": "Ctrl+A",
    "duplicate": "Ctrl+D",
    "delete": "Delete",
    "search_node": "Tab",
    "fit_graph": "F",
    "fit_graph_alt": "Shift+F",
    "organize_graph": "Ctrl+Shift+O",
    "toggle_fullscreen": "F11",
    "focus_viewport": "Ctrl+1",
    "focus_graph": "Ctrl+2",
    "focus_timeline": "Ctrl+3",
    "focus_properties": "Ctrl+4",
    "reset_layout": "Ctrl+Shift+R",
    "show_all_panels": "Ctrl+Shift+P",
    "play_pause": "Space",
    "go_to_start": "Home",
    "step_back": "Left",
    "step_forward": "Right",
    "go_to_end": "End",
    "mark_in": "I",
    "mark_out": "O",
    "show_shortcuts": "Ctrl+/",
    "open_preferences": "Ctrl+,"
  },
